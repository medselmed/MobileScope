<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_net_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/w_net_ring"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_net_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8A94A8"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/w_net_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#EEF2F8"
            android:textSize="16sp" android:textStyle="bold" />
        <TextView
            android:id="@+id/w_net_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B7C0D4"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/w_net_plan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#2DD4F0"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
        <TextView
            android:id="@+id/w_net_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#5E6A82"
            android:textSize="10sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
